{
  "name": "ordo",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Android-first video editor with a shared web build",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "test:mobile": "node scripts/mobile-smoke.mjs",
    "test:composition": "node scripts/composition-smoke.mjs",
    "test:creative": "node scripts/creative-smoke.mjs",
    "test:bulk": "node scripts/bulk-smoke.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@fontsource/lato": "5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/open-sans": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "idb": "8.0.4",
    "mediabunny": "1.62.0",
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
