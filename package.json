{
  "name": "ordo",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Video editor for Android",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "test:mobile": "node scripts/mobile-smoke.mjs",
    "test:composition": "node scripts/composition-smoke.mjs",
    "test:creative": "node scripts/creative-smoke.mjs",
    "test:bulk": "node scripts/bulk-smoke.mjs",
    "test:touch-preview": "node scripts/touch-preview-smoke.mjs",
    "test:audio": "node scripts/audio-relink-smoke.mjs",
    "test:images": "node scripts/images-smoke.mjs",
    "test:export-fallback": "node scripts/export-fallback-smoke.mjs",
    "test:export-duration": "node scripts/export-duration-smoke.mjs",
    "build:landing": "node scripts/build-landing.mjs",
    "dev:landing": "vite website --host 127.0.0.1",
    "test:titles": "node scripts/title-controls-smoke.mjs",
    "test:updates": "node scripts/update-prompt-smoke.mjs",
    "test:speed": "node scripts/speed-smoke.mjs"
  },
